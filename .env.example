# === LLM Provider ===
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# === App Environment ===
# development -> defaults to Chroma
# production  -> defaults to Qdrant
APP_ENV=development

# === Vector Store ===
# Optional override: chroma or qdrant.
# Leave blank to auto-select from APP_ENV.
VECTOR_BACKEND=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# === Memory ===
MEMORY_ENCRYPTION_KEY=

# === Observability ===
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# === API Security ===
ALLOWED_API_KEYS=dev-local-key

# === Inventory Database ===
# PostgreSQL connection string — leave empty to use mock data (dev).
# Used by DatabaseClient (direct mode) and by the MCP postgres server.
# Examples:
#   postgresql://user:pass@localhost:5432/inventory
#   postgresql://user:pass@cloud.postgres.com:5432/inventory?sslmode=require
DATABASE_URL=

# === MCP Servers (official Anthropic registry) ===
# @anthropic/mcp-server-postgres — provides postgres query tools to the LLM
# @anthropic/mcp-server-slack    — provides Slack messaging for escalations
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# === Inventory System ===
STOCK_AUDIT_INTERVAL_MINUTES=60
USE_MOCK_SUPPLIER_API=true
