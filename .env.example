# ─────────────────────────────────────────────────────────────────────────────
# INVENTORY-REPLENISHMENT-AGENT — .env.example
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# Variables prefixed with # are optional.
# ─────────────────────────────────────────────────────────────────────────────

# === App Environment ===
# development -> defaults to Chroma (local)
# staging     -> Qdrant cloud
# production  -> Qdrant cloud
APP_ENV=development

# === LLM Provider ===
GOOGLE_API_KEY=

# === Vector Store ===
# Optional override: chroma or qdrant.
# Leave blank to auto-select from APP_ENV.
VECTOR_BACKEND=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# === API Security ===
# Comma-separated list of valid API keys (≥32 chars each in production)
ALLOWED_API_KEYS=dev-local-key

# === Memory ===
# 32-byte base64-encoded key for encrypting agent memory
MEMORY_ENCRYPTION_KEY=

# === Observability ===
# Set LANGSMITH_TRACING=true to enable automatic LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=INVENTORY-AGENT-DEV

# === Inventory Database ===
# PostgreSQL connection string — leave empty to use mock data (dev).
# Used by DatabaseClient (direct mode) and by the MCP postgres server.
# Examples:
#   postgresql://user:pass@localhost:5432/inventory
#   postgresql://user:pass@cloud.postgres.com:5432/inventory?sslmode=require
DATABASE_URL=

# === MCP Servers ===
# @anthropic/mcp-server-slack — provides Slack messaging for escalations
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
# Slack incoming webhook for CI/CD pipeline notifications
SLACK_WEBHOOK_URL=

# === Inventory System ===
STOCK_AUDIT_INTERVAL_MINUTES=60
USE_MOCK_SUPPLIER_API=true

# ─────────────────────────────────────────────────────────────────────────────
# Azure Deployment (GitHub Actions secrets — not needed locally)
# ─────────────────────────────────────────────────────────────────────────────
 ACR_LOGIN_SERVER=inventoryregistry.azurecr.io
 ACR_USERNAME=<service-principal-app-id>
 ACR_PASSWORD=<service-principal-client-secret>
 AZURE_TENANT_ID=<azure-ad-tenant-id>
 AZURE_SUBSCRIPTION_ID=<azure-subscription-id>
 AZURE_RESOURCE_GROUP=<resource-group-name>
 AZURE_CONTAINERAPP_API_STAGING=<aca-staging-app-name>
 AZURE_CONTAINERAPP_API_PROD=<aca-prod-app-name>
